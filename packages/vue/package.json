{
  "name": "@text-trace/vue",
  "version": "0.1.0",
  "description": "Vue component for SVG text tracing animation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/text-trace.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/Jannchie/text-trace#readme",
  "bugs": {
    "url": "https://github.com/Jannchie/text-trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue --external @text-trace/core",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@text-trace/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  }
}

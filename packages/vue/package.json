{
  "name": "@text-trace/vue",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external vue --external @text-trace/core",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@text-trace/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  }
}

{
  "name": "@text-trace/core",
  "version": "0.2.0",
  "description": "Framework-agnostic SVG text tracing animation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/text-trace.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Jannchie/text-trace#readme",
  "bugs": {
    "url": "https://github.com/Jannchie/text-trace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7"
  }
}
